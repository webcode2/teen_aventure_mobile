# Client Firebase values for Flutter. Copy this file to .env (git ignores it)
# and pass it at run/build time:
#   flutter run --dart-define-from-file=.env
#   flutter build ipa --dart-define-from-file=.env
# build_apk.sh adds these for Android automatically.
#
# Get the keys from Firebase Console (project tbaapplication) → Project settings
# → Your apps. Android app: com.tba.askadonai. iOS app: com.tba.askadonai.
# Without them the app runs, but push notifications stay off.
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=

# Optional Android-only overrides of the whole Firebase config
# (build_apk.sh fills them from android/app/google-services.json).
# See docs/ops/runbook.md § Push.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Optional: also download google-services.json into mobile_/android/app/
# (Gradle applies the Google Services plugin only when that file exists).

# Current deployed public/API origin. Debug builds may override this for local HTTP.
API_BASE_URL=https://tba.elastrocloud.com
WEB_BASE_URL=https://tba.elastrocloud.com
