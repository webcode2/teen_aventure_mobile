# Client Firebase values for Flutter (not loaded automatically).
# Pass them at run/build time, e.g.:
#   flutter run \
#     --dart-define=FIREBASE_API_KEY=... \
#     --dart-define=FIREBASE_APP_ID=... \
#     --dart-define=FIREBASE_MESSAGING_SENDER_ID=... \
#     --dart-define=FIREBASE_PROJECT_ID=...
#
# Get these from Firebase Console → Project settings → Your apps → Android app
# (package com.elasctroclud.teen_aventure). See docs/ops/runbook.md § Push.

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Optional: also download google-services.json into mobile_/android/app/
# (Gradle applies the Google Services plugin only when that file exists).
