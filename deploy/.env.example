# Runtime env for the API container. Database hosts are Docker network names.
NODE_ENV=production
PORT=8080
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL="postgresql://USER:PASSWORD@pgbouncer:6432/DBNAME?schema=public&pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@postgres:5432/DBNAME?schema=public"
CORS_ORIGINS=https://teen.elastrocloud.com
ADMIN_PUBLIC_URL=https://teen.elastrocloud.com
# Firebase Cloud Messaging (device push). Without these, PUSH rows stay PENDING.
# Console: Project settings → Service accounts → Generate new private key.
# Paste JSON as one line, or mount the file and set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json
# RESEND_API_KEY=
# MAIL_FROM=Teen Bible Adventures <noreply@your-verified-domain.com>
# EMAIL_FROM=Teen Bible Adventures <noreply@your-verified-domain.com>
